flowchart TB
    U["用户选择入口"] --> E{"本次意图"}
    subgraph GEN["generate：独立的一次生成请求"]
        G0["开场 1：确定新项目或旧项目<br/>已有答案直接复用"]
        GI["开场 2：收集必要输入<br/>PRD、高阶设计；旧项目另需往期 SOW<br/>文本 / XLSX；原型资源包可选"]
        G1{"必需材料齐备<br/>且内容可分析？"}
        GN["列出具体缺失资料及用途<br/>本次不伪造完整 SOW"]
        G2["读取全部输入的相关用途<br/>文本 / Excel 定位；原型自主探索<br/>未读、不可读或冲突如实记录"]
        GA["往期 SOW → 估算 as-is<br/>新项目无历史可为空；旧项目缺件需补料"]
        GT["PRD / HLD / 原型 / draft → to-be<br/>业务、技术 / NFR、交付目标与责任"]
        GG["Agent 对照 as-is / to-be 识别本期 gap<br/>已满足且无工作不计入；模板仅提供规则"]
        G3{"分析全部输入及最新答复<br/>基础信息是否补足？"}
        GQL{"仍有主动提问轮次？<br/>首轮 + 最多一轮补问"}
        GQ["仅澄清和确认输入相关事项<br/>业务 / 技术 / 交付事实、冲突与决定<br/>首轮问题包 + 最多一轮补问，不审批拆解与分类"]
        GB["由本期 gap 形成 Epic / Feature 骨架<br/>公共能力、业务接入、迁移 / 上线<br/>明确本期与外部责任及依赖"]
        GS["选择关联切片并加载上下文<br/>业务 / 技术 / 交付可联合处理"]
        G4["联合形成本片 Story、来源 AC、备注<br/>公共建设与接入分别拆工作<br/>Task 分类：实例适用明确才按变化判断<br/>无候选新建；实例未定新建 + 待确认"]
        GC["复用候选：工作方式为新建<br/>具体历史候选与问题随 SOW 带出"]
        GP["复杂度无法识别：M + 待确认<br/>其他缺依据字段留空并关联问题<br/>不猜前提或方案，不为定档反复补证"]
        GL["局部检查并保存候选<br/>无新增用户批准，不单独交付半成品"]
        GR{"还有未完成切片？"}
        GM["合并检查三类 gap 覆盖及已满足说明<br/>公共建设只计一次、接入不漏<br/>交付责任、依赖与汇总一致"]
        G5{"基本信息仍充分<br/>仅有可定位的局部缺项？"}
        G6["保留模板计算、检查与复读 Excel<br/>允许已说明的留空，缺项不冒充完整总量"]
        GE["保存有效版本并返回 Excel<br/>generate 结束"]
    end
    subgraph CLA["clarify：用户另行发起的一次调整请求"]
        C0{"共享文件中存在可用基线？"}
        CN["说明缺失或不兼容文件<br/>恢复基线或请用户先使用 generate"]
        C1["读取相关模型、问题及证据<br/>定位业务 / 公共能力与接入 / 交付影响"]
        C2["交互讨论具体方案<br/>写对象、依赖、回查深度、变化影响"]
        C3{"用户是否确认当前方案？"}
        CQ{"仍有本次方案修订额度？<br/>首份方案 + 最多一轮修订"}
        CS["保留原版本<br/>保存草案或结束讨论"]
        C4{"基线及确认条件仍有效？"}
        C5["应用确认切片<br/>禁止擅自扩大写范围与回查范围"]
        C6{"能在已确认方案内完成？"}
        C7["必要检查、局部重算、生成 Excel<br/>待确认项随应用结果同步更新"]
        CE["提交一致的新版本并返回 Excel<br/>clarify 结束"]
    end
    subgraph ERR["两入口共用的故障原则"]
        T0["技术故障 / 明确内容错误<br/>保存有效前序，定位最小修复范围"]
        T1{"有明确修法、剩余返修次数<br/>且仍在本次边界内？"}
        T2["仅修相关对象或失败工具步骤<br/>成功则续接原失败位置"]
        T3["无进展或范围不再成立：退出本次应用<br/>保留上次有效版本，返回具体诊断"]
    end
    F[("共享文件<br/>输入 / 依据 / 模型 / 待确认项 / 当前版本")]
    OUT["用户拿到 Excel 和待确认项<br/>可以直接离开，无定稿步骤"]
    E -->|首次生成| G0
    E -->|反馈调整| C0
    G0 --> GI
    GI --> G1
    G1 -->|否| GN
    G1 -->|是| G2
    G2 --> GA
    G2 --> GT
    GA --> GG
    GT --> GG
    GG --> G3
    G3 -->|缺少大量基础资料| GN
    G3 -->|少量关键输入问题| GQL
    GQL -->|有额度且下一问题包有价值| GQ
    GQL -->|到限 / 无实质进展| GN
    GQ -->|收到答复或补充，复核相关分析| G3
    GQ -->|未补充或用户暂停：不向下推进| GN
    G3 -->|信息已补足| GB
    GB --> GS
    GS --> G4
    G4 -->|候选实例 / 适用未定| GC
    GC --> GL
    G4 -->|其他局部缺值| GP
    GP --> GL
    G4 -->|无新增未决项| GL
    GL --> GR
    GR -->|有| GS
    GR -->|没有| GM
    GM --> G5
    G5 -->|否| GN
    G5 -->|是：已有依据内容及局部留空| G6
    G6 --> GE
    GE --> OUT
    C0 -->|否| CN
    C0 -->|是| C1
    C1 --> C2
    C2 --> C3
    C3 -->|未确认 / 取消| CS
    C3 -->|已确认| C4
    C4 -->|相关内容已变化| CQ
    C4 -->|有效| C5
    C5 --> C6
    C6 -->|需改变方案 / 扩大切片| CQ
    CQ -->|有且新范围可闭合| C2
    CQ -->|到限 / 无进展| CS
    C6 -->|可以；缺依据字段留空并记录| C7
    C7 --> CE
    CE --> OUT
    G2 -.读取.-> F
    GL -.保存本片草案.-> F
    GE -.写入.-> F
    C1 -.读取.-> F
    CE -.写入.-> F
    G2 -.故障.-> T0
    GB -.骨架错误.-> T0
    G4 -.本片内容错误.-> T0
    GL -.本片检查失败.-> T0
    GM -.跨片检查失败.-> T0
    G6 -.检查 / 导出失败.-> T0
    C5 -.故障.-> T0
    C7 -.检查 / 导出失败.-> T0
    T0 --> T1
    T1 -->|是| T2
    T1 -->|到限 / 无修法 / 同因无进展| T3
    T2 --> T4{"原失败位置"}
    T4 -->|generate 输入分析| G2
    T4 -->|generate 骨架局部修正| GB
    T4 -->|generate 本片内容| G4
    T4 -->|generate 本片检查| GL
    T4 -->|generate 跨片检查| GM
    T4 -->|generate 文件检查| G6
    T4 -->|clarify 切片应用| C5
    T4 -->|clarify 文件检查| C7
    OUT -->|用户有反馈，另行发起 clarify| C0
