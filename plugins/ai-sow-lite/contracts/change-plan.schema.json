{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change-plan.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "base_version_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "read_boundary": {
      "type": "object",
      "properties": {
        "input_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "uniqueItems": true
        },
        "topic_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "uniqueItems": true
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "uniqueItems": true
        },
        "depth": {
          "enum": [
            "current",
            "topic",
            "source"
          ]
        }
      },
      "required": [
        "input_version_ids",
        "topic_version_ids",
        "object_ids",
        "depth"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "minLength": 36,
        "maxLength": 36
      },
      "uniqueItems": true
    },
    "change_summary": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "read_set": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "selector": {
            "$ref": "#/$defs/read_selector"
          },
          "observed_version": {}
        },
        "required": [
          "selector",
          "observed_version"
        ],
        "additionalProperties": false
      }
    },
    "write_set": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collection": {
            "enum": [
              "epics",
              "features",
              "stories",
              "acs",
              "tasks",
              "dependencies",
              "lineage",
              "pending_items",
              "decisions",
              "input_refs",
              "topic_refs",
              "evidence_refs"
            ]
          },
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "collection",
          "object_id",
          "field"
        ],
        "additionalProperties": false
      }
    },
    "confirmation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/confirmation"
        }
      ]
    },
    "subset_of": {
      "$ref": "artifacts.schema.json#/$defs/file_ref"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "revision",
    "base_version_id",
    "read_boundary",
    "conditions",
    "unresolved_items",
    "change_summary",
    "changes",
    "read_set",
    "write_set",
    "confirmation"
  ],
  "additionalProperties": false,
  "$defs": {
    "edit_draft": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "base_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "read_boundary": {
          "type": "object",
          "properties": {
            "input_version_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "uniqueItems": true
            },
            "topic_version_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "uniqueItems": true
            },
            "object_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "uniqueItems": true
            },
            "depth": {
              "enum": [
                "current",
                "topic",
                "source"
              ]
            }
          },
          "required": [
            "input_version_ids",
            "topic_version_ids",
            "object_ids",
            "depth"
          ],
          "additionalProperties": false
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_items": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "uniqueItems": true
        },
        "change_summary": {
          "type": "string",
          "minLength": 1
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edit"
          }
        },
        "read_selectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/read_selector"
          }
        },
        "additional_refs": {
          "type": "object",
          "properties": {
            "input_version_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "uniqueItems": true
            },
            "topic_version_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "uniqueItems": true
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "uniqueItems": true
            }
          },
          "required": [
            "input_version_ids",
            "topic_version_ids",
            "evidence_ids"
          ],
          "additionalProperties": false
        },
        "subset_of": {
          "$ref": "artifacts.schema.json#/$defs/file_ref"
        },
        "repair": {
          "type": "object",
          "properties": {
            "draft_ref": {
              "$ref": "artifacts.schema.json#/$defs/file_ref"
            },
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "draft_ref",
            "operation",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "plan_id",
        "revision",
        "base_version_id",
        "read_boundary",
        "conditions",
        "unresolved_items",
        "change_summary",
        "edits",
        "read_selectors",
        "additional_refs"
      ],
      "additionalProperties": false
    },
    "edit": {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "add",
            "replace",
            "remove"
          ]
        },
        "collection": {
          "enum": [
            "epics",
            "features",
            "stories",
            "acs",
            "tasks",
            "dependencies",
            "lineage",
            "pending_items",
            "decisions",
            "input_refs",
            "topic_refs",
            "evidence_refs"
          ]
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {}
      },
      "required": [
        "op",
        "collection",
        "object_id",
        "field"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "remove"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          },
          "else": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "change": {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "add",
            "replace",
            "remove"
          ]
        },
        "collection": {
          "enum": [
            "epics",
            "features",
            "stories",
            "acs",
            "tasks",
            "dependencies",
            "lineage",
            "pending_items",
            "decisions",
            "input_refs",
            "topic_refs",
            "evidence_refs"
          ]
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        },
        "before": {},
        "after": {}
      },
      "required": [
        "op",
        "collection",
        "object_id",
        "field",
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "address": {
      "type": "object",
      "properties": {
        "collection": {
          "enum": [
            "epics",
            "features",
            "stories",
            "acs",
            "tasks",
            "dependencies",
            "lineage",
            "pending_items",
            "decisions",
            "input_refs",
            "topic_refs",
            "evidence_refs"
          ]
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "collection",
        "object_id",
        "field"
      ],
      "additionalProperties": false
    },
    "confirmation": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^json-v1:[0-9a-f]{64}$",
          "minLength": 72,
          "maxLength": 72
        },
        "input_ref": {
          "$ref": "evidence.schema.json#/$defs/source_ref"
        },
        "shown_plan_ref": {
          "$ref": "artifacts.schema.json#/$defs/file_ref"
        },
        "selected_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      },
      "required": [
        "digest",
        "input_ref",
        "shown_plan_ref",
        "selected_changes"
      ],
      "additionalProperties": false
    },
    "read_selector": {
      "allOf": [
        {
          "$ref": "protocol.schema.json#/$defs/inspect_payload"
        },
        {
          "properties": {
            "view": {
              "enum": [
                "inputs",
                "regions",
                "topics",
                "current",
                "objects",
                "standards"
              ]
            },
            "selector": {}
          },
          "required": [
            "view",
            "selector"
          ],
          "type": "object",
          "additionalProperties": false
        }
      ]
    }
  }
}
