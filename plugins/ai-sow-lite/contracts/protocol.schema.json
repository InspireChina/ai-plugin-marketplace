{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "project_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "operation": {
      "enum": [
        "ingest",
        "inspect",
        "check",
        "render",
        "apply",
        "recover"
      ]
    },
    "payload": {
      "type": "object"
    },
    "observation_context": {
      "type": "object",
      "properties": {
        "execution_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "activity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "slice_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "project_path",
    "operation",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "check"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/check_payload"
          }
        }
      }
    }
  ],
  "$defs": {
    "response": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "minLength": 36,
              "maxLength": 36
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": "object"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "artifacts.schema.json#/$defs/diagnostic"
          },
          "minItems": 0
        }
      },
      "required": [
        "ok",
        "request_id",
        "operation",
        "result",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "check_payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "candidate_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "scope": {
              "enum": [
                "slice",
                "full"
              ]
            },
            "plan_path": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "candidate_path",
            "scope",
            "plan_path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "edit_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "scope": {
              "const": "full"
            }
          },
          "required": [
            "edit_path",
            "scope"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
