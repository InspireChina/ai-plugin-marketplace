{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "project_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "operation": {
      "enum": [
        "ingest",
        "inspect",
        "check",
        "render",
        "apply",
        "recover"
      ]
    },
    "payload": {
      "type": "object"
    },
    "observation_context": {
      "type": "object",
      "properties": {
        "execution_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "activity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "slice_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "project_path",
    "operation",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "check"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/check_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "ingest"
          },
          "payload": {
            "required": [
              "entrypoint"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ingest_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "inspect"
          },
          "payload": {
            "minProperties": 1
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/inspect_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "apply"
          },
          "payload": {
            "minProperties": 1
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/apply_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "recover"
          },
          "payload": {
            "minProperties": 1
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/recover_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "render"
          },
          "payload": {
            "minProperties": 1
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/render_payload"
          }
        }
      }
    }
  ],
  "$defs": {
    "response": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "minLength": 36,
              "maxLength": 36
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": "object"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "artifacts.schema.json#/$defs/diagnostic"
          },
          "minItems": 0
        }
      },
      "required": [
        "ok",
        "request_id",
        "operation",
        "result",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "check_payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "candidate_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "scope": {
              "enum": [
                "slice",
                "full"
              ]
            },
            "plan_path": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "candidate_path",
            "scope",
            "plan_path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "edit_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "scope": {
              "const": "full"
            }
          },
          "required": [
            "edit_path",
            "scope"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ingest_payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sources"
            },
            "entrypoint": {
              "enum": [
                "generate",
                "clarify"
              ]
            },
            "project_type": {
              "enum": [
                "new",
                "existing"
              ]
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source_path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "input_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                        "minLength": 36,
                        "maxLength": 36
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "material_types": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "uses": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "use_regions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "material_type": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "use": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "locators": {
                          "type": "array",
                          "items": {
                            "$ref": "evidence.schema.json#/$defs/locator"
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "material_type",
                        "use",
                        "locators"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "source_path",
                  "input_id",
                  "material_types",
                  "uses",
                  "use_regions"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "entrypoint",
            "project_type",
            "sources"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "analysis"
            },
            "entrypoint": {
              "enum": [
                "generate",
                "clarify"
              ]
            },
            "analysis_path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            }
          },
          "required": [
            "kind",
            "entrypoint",
            "analysis_path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "inspect_payload": {
      "type": "object",
      "properties": {
        "view": {
          "enum": [
            "inputs",
            "regions",
            "topics",
            "current",
            "request",
            "objects",
            "standards",
            "telemetry"
          ]
        },
        "selector": {
          "type": "object"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        }
      },
      "required": [
        "view",
        "selector"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "view": {
                "const": "inputs"
              }
            }
          },
          "then": {
            "properties": {
              "selector": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "input_version_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                          "minLength": 36,
                          "maxLength": 36
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "input_version_ids"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "input_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                          "minLength": 36,
                          "maxLength": 36
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "input_ids"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "topics"
              }
            }
          },
          "then": {
            "properties": {
              "selector": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "topic_version_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                          "minLength": 36,
                          "maxLength": 36
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "topic_version_ids"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "topic_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                          "minLength": 36,
                          "maxLength": 36
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "topic_ids"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "regions"
              }
            }
          },
          "then": {
            "properties": {
              "selector": {
                "type": "object",
                "properties": {
                  "input_version_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                    "minLength": 36,
                    "maxLength": 36
                  },
                  "locator": {
                    "$ref": "evidence.schema.json#/$defs/locator"
                  }
                },
                "required": [
                  "input_version_id",
                  "locator"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "current"
              }
            }
          },
          "then": {
            "properties": {
              "selector": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "request"
              }
            }
          },
          "then": {
            "properties": {
              "selector": {
                "type": "object",
                "properties": {
                  "request_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                    "minLength": 36,
                    "maxLength": 36
                  }
                },
                "required": [
                  "request_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "objects"
              }
            }
          },
          "then": {
            "properties": {
              "selector": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "collection": {
                        "enum": [
                          "epics",
                          "features",
                          "stories",
                          "acs",
                          "tasks",
                          "dependencies",
                          "pending_items",
                          "decisions"
                        ]
                      },
                      "version_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                        "minLength": 36,
                        "maxLength": 36
                      },
                      "object_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                          "minLength": 36,
                          "maxLength": 36
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "collection",
                      "object_ids"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "collection": {
                        "enum": [
                          "epics",
                          "features",
                          "stories",
                          "acs",
                          "tasks",
                          "dependencies",
                          "pending_items",
                          "decisions"
                        ]
                      },
                      "version_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                        "minLength": 36,
                        "maxLength": 36
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "collection",
                      "title"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "collection": {
                        "const": "pending_items"
                      },
                      "version_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                        "minLength": 36,
                        "maxLength": 36
                      },
                      "status": {
                        "enum": [
                          "open",
                          "resolved",
                          "superseded"
                        ]
                      }
                    },
                    "required": [
                      "collection",
                      "status"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "collection": {
                        "const": "dependencies"
                      },
                      "version_id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                        "minLength": 36,
                        "maxLength": 36
                      },
                      "relation": {
                        "type": "object",
                        "properties": {
                          "object_id": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                            "minLength": 36,
                            "maxLength": 36
                          },
                          "direction": {
                            "enum": [
                              "incoming",
                              "outgoing",
                              "both"
                            ]
                          }
                        },
                        "required": [
                          "object_id",
                          "direction"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "collection",
                      "relation"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "view": {
                "const": "standards"
              }
            }
          },
          "then": {
            "properties": {
              "selector": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {},
                    "required": [],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "work_type_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "work_type_ids"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "work_type_names": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "work_type_names"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "recover_payload": {
      "type": "object",
      "properties": {
        "target_request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        }
      },
      "required": [
        "target_request_id"
      ],
      "additionalProperties": false
    },
    "apply_payload": {
      "type": "object",
      "properties": {
        "entrypoint": {
          "enum": [
            "generate",
            "clarify"
          ]
        },
        "prepared_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "expected_current": {
          "anyOf": [
            {
              "$ref": "artifacts.schema.json#/$defs/current"
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "entrypoint",
        "prepared_path",
        "expected_current",
        "plan_path"
      ],
      "additionalProperties": false
    },
    "render_payload": {
      "type": "object",
      "properties": {
        "candidate_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "check_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "expected_current": {
          "anyOf": [
            {
              "$ref": "artifacts.schema.json#/$defs/current"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "candidate_path",
        "check_path",
        "expected_current"
      ],
      "additionalProperties": false
    }
  }
}
