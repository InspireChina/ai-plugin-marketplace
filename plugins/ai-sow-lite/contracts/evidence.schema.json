{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "kind": {
          "enum": [
            "statement",
            "observation",
            "judgment"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "minItems": 0
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "limitations": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "source_refs",
        "basis_refs",
        "limitations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "judgment"
              }
            }
          },
          "then": {
            "properties": {
              "basis_refs": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "source_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text_lines"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
              "description": "单文件可省略；提供时精确匹配已登记 input.relative_path 或 basename。prototype 必须提供精确资源包内相对路径；不跟随任意外部路径。"
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            },
            "heading_path": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 0
            }
          },
          "required": [
            "kind",
            "start_line",
            "end_line"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "xlsx_range"
            },
            "sheet": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "range": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "read_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "minLength": 36,
              "maxLength": 36
            }
          },
          "required": [
            "kind",
            "sheet",
            "range",
            "read_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "observation"
            },
            "observation_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "minLength": 36,
              "maxLength": 36
            },
            "attachment": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
              "description": "原始 observation 附件列表中的项目相对路径，或该附件采用后的不可变路径；不是任意图片引用。"
            },
            "region": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "observation_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "input_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "excerpt_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "input_version_id",
        "locator",
        "excerpt_hash"
      ],
      "additionalProperties": false
    }
  }
}
