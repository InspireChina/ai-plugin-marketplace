{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pending-items.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "current_handling": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "unestimated_work": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "superseded"
          ]
        },
        "resolution": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/resolved"
            },
            {
              "$ref": "#/$defs/superseded"
            }
          ]
        }
      },
      "required": [
        "id",
        "revision",
        "question",
        "targets",
        "evidence_refs",
        "current_handling",
        "unestimated_work",
        "status",
        "resolution"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "open"
              }
            }
          },
          "then": {
            "properties": {
              "resolution": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            }
          },
          "then": {
            "properties": {
              "resolution": {
                "$ref": "#/$defs/resolved"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "superseded"
              }
            }
          },
          "then": {
            "properties": {
              "resolution": {
                "$ref": "#/$defs/superseded"
              }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "field": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "object_id",
        "field"
      ],
      "additionalProperties": false
    },
    "lineage_key": {
      "type": "object",
      "properties": {
        "from_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "from_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "from_version_id",
        "from_ids"
      ],
      "additionalProperties": false
    },
    "resolved": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "decision_id",
        "request_id",
        "summary"
      ],
      "additionalProperties": false
    },
    "superseded": {
      "type": "object",
      "properties": {
        "replacement_item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "lineage_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lineage_key"
          },
          "minItems": 0
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "replacement_item_ids",
        "lineage_refs",
        "request_id",
        "reason"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "replacement_item_ids": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "lineage_refs": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
