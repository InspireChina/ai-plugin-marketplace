{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifacts.schema.json",
  "$defs": {
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "target": {
          "type": "object",
          "properties": {
            "path": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "object_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "minLength": 36,
                  "maxLength": 36
                },
                {
                  "type": "null"
                }
              ]
            },
            "field": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "path",
            "object_id",
            "field"
          ],
          "additionalProperties": false
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "preserved_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "minItems": 0
        }
      },
      "required": [
        "code",
        "target",
        "message",
        "preserved_paths"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "input_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "input_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "format": {
          "enum": [
            "text",
            "xlsx",
            "prototype"
          ]
        },
        "encoding": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "material_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "use_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "material_type": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "use": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "locators": {
                "type": "array",
                "items": {
                  "$ref": "evidence.schema.json#/$defs/locator"
                },
                "minItems": 1
              }
            },
            "required": [
              "material_type",
              "use",
              "locators"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "input_version_id",
        "input_id",
        "content_hash",
        "relative_path",
        "format",
        "material_types",
        "uses",
        "use_regions"
      ],
      "additionalProperties": false
    },
    "input_index": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "items"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "project_type": {
          "enum": [
            "new",
            "existing"
          ]
        },
        "template_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "project_type",
        "template_hash"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "entrypoint": {
          "enum": [
            "generate",
            "clarify"
          ]
        },
        "base_version_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "minLength": 36,
              "maxLength": 36
            },
            {
              "type": "null"
            }
          ]
        },
        "model_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "pending_items_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "decisions_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "input_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "topic_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "template_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "schema_version",
        "entrypoint",
        "base_version_id",
        "model_path",
        "pending_items_path",
        "decisions_path",
        "evidence_ids",
        "input_version_ids",
        "topic_version_ids",
        "template_hash"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "evidence.schema.json#/$defs/item"
          },
          "minItems": 0
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topic"
          },
          "minItems": 1
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "evidence",
        "topics",
        "observations"
      ],
      "additionalProperties": false
    },
    "topic": {
      "type": "object",
      "properties": {
        "topic_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "topic_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "input_version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "covered_regions": {
          "type": "array",
          "items": {
            "$ref": "evidence.schema.json#/$defs/source_ref"
          },
          "minItems": 0
        },
        "uncovered_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "input_version_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "locator": {
                "$ref": "evidence.schema.json#/$defs/locator"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "input_version_id",
              "locator",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "related_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "external_responsibilities": {
          "type": "string"
        },
        "limitations": {
          "type": "string"
        },
        "conclusion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "historical_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "description": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "minLength": 36,
                  "maxLength": 36
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "level": {
                "enum": [
                  "epic",
                  "feature",
                  "story",
                  "task"
                ]
              },
              "parent_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "minLength": 36,
                "maxLength": 36
              },
              "type_hint": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "instance_facts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                        "minLength": 36,
                        "maxLength": 36
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "text",
                    "evidence_refs"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "label",
              "description",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "topic_id",
        "topic_version_id",
        "title",
        "input_version_ids",
        "uses",
        "covered_regions",
        "uncovered_regions",
        "evidence_refs",
        "related_object_ids",
        "external_responsibilities",
        "limitations",
        "conclusion",
        "historical_items"
      ],
      "additionalProperties": false
    },
    "reading": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "read_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "input_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "options": {
          "type": "object",
          "properties": {
            "data_only": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "excerpts": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "sheet": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "range": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "file_ref": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$",
                        "minLength": 64,
                        "maxLength": 64
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "sheet",
                  "range",
                  "file_ref"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "locator": {
                    "allOf": [
                      {
                        "$ref": "evidence.schema.json#/$defs/locator"
                      },
                      {
                        "properties": {
                          "kind": {
                            "const": "text_lines"
                          }
                        }
                      }
                    ]
                  },
                  "file_ref": {
                    "$ref": "#/$defs/file_ref"
                  }
                },
                "required": [
                  "locator",
                  "file_ref"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "read_id",
        "input_version_id",
        "content_hash",
        "adapter_version",
        "options",
        "excerpts"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "input_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "preconditions": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "observed_at": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "result": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "resource_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "limitations": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "observation_id",
        "input_version_id",
        "entrypoint",
        "preconditions",
        "actions",
        "observed_at",
        "result",
        "resource_refs",
        "attachments",
        "limitations"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "validator_version": {
          "const": "lite-check-v1"
        },
        "scope": {
          "enum": [
