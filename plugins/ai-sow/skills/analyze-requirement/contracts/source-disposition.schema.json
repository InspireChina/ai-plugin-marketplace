{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:analyze-requirement:source-disposition:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": {
      "const": "0.1",
      "description": "当前 work-only 来源处置合同版本。"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"},
      "description": "逐条记录会影响业务或后续设计边界的明确来源陈述及其唯一处置。"
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "sourceDocumentId": {
      "type": "string",
      "pattern": "^source-document-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "targetId": {
      "type": "string",
      "pattern": "^(?:norm|epic|feature)-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispositionId",
        "sourceDocumentId",
        "sourceReference",
        "summary",
        "disposition",
        "targetIds",
        "rationale"
      ],
      "properties": {
        "dispositionId": {
          "type": "string",
          "pattern": "^source-disposition-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "work-only 来源处置条目的稳定标识，用于同一评审版本内定位。"
        },
        "sourceDocumentId": {
          "$ref": "#/$defs/sourceDocumentId",
          "description": "当前陈述所在的已登记来源文件 ID。"
        },
        "sourceReference": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "足以回到原文核对的章节、段落或表格定位，不复制完整来源。"
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "保持原意的简洁陈述，用于 Reviewer 检查是否遗漏或误分类。"
        },
        "disposition": {
          "enum": ["BUSINESS", "DESIGN_INPUT", "SCOPE_BOUNDARY", "EXCLUDED"],
          "description": "BUSINESS 进入业务需求；DESIGN_INPUT 留给设计；SCOPE_BOUNDARY 映射业务范围边界；EXCLUDED 明确说明不进入本次交付。"
        },
        "targetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/targetId"},
          "description": "BUSINESS 或 SCOPE_BOUNDARY 直接影响的 candidate ID；其他处置保持空数组。"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "说明该处置为何正确，以及后续 Owner 应如何消费或为何排除。"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "BUSINESS"}}},
          "then": {"properties": {"targetIds": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"disposition": {"const": "SCOPE_BOUNDARY"}}},
          "then": {"properties": {"targetIds": {"minItems": 1}}}
        },
        {
          "if": {
            "properties": {
              "disposition": {"enum": ["DESIGN_INPUT", "EXCLUDED"]}
            }
          },
          "then": {"properties": {"targetIds": {"maxItems": 0}}}
        }
      ]
    }
  }
}
