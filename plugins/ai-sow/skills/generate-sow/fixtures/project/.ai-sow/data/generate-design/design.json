  "decisions": [
    {
      "designDecisionId": "decision-profile-api",
      "name": "公开客户档案 API",
      "decision": "使用专用 API 边界处理档案写入、查询和授权过滤。",
      "rationale": "会员门户与后续渠道需要统一边界，且会员主数据不能直接暴露。",
      "designItemIds": ["design-customer-profile"],
      "effectiveStartItemIds": ["effective-start-customer-profile"],
      "relatedFeatureIds": ["feature-customer-profile", "feature-profile-api"],
      "decisionKind": "INTEGRATION_BOUNDARY",
      "evidenceIds": ["evidence-profile-component"]
    },
    {
      "designDecisionId": "decision-order-state-machine",
      "name": "订单状态由领域服务统一编排",
      "decision": "门店与线上订单共用一个幂等状态机，渠道只提交命令并读取轨迹。",
      "rationale": "避免渠道各自维护状态导致履约、退款与财务口径分裂。",
      "designItemIds": ["design-order-domain", "design-store-workbench"],
      "effectiveStartItemIds": ["effective-start-order-service"],
      "relatedFeatureIds": [
        "feature-order-orchestration",
        "feature-return-refund",
        "feature-store-order",
        "feature-order-visibility"
      ],
      "decisionKind": "OTHER",
      "evidenceIds": []
    },
    {
      "designDecisionId": "decision-integration-boundary",
      "name": "复用企业级连接并隔离外部差异",
      "decision": "ERP、支付和发票平台均通过项目适配层接入，外部契约不进入订单核心模型。",
      "rationale": "便于独立认证、映射、错误补偿与供应商变更。",
      "designItemIds": ["design-integration-adapters"],
      "effectiveStartItemIds": [
        "effective-start-erp-interface",
        "effective-start-payment-gateway",
        "effective-start-invoice-gateway"
      ],
      "relatedFeatureIds": [
        "feature-inventory-reservation",
        "feature-return-refund",
        "feature-einvoice"
      ],
      "decisionKind": "INTEGRATION_BOUNDARY",
      "evidenceIds": [
        "evidence-erp-contract",
        "evidence-payment-contract",
        "evidence-invoice-contract"
      ]
    },
    {
      "designDecisionId": "decision-finance-control",
      "name": "财务指标与对账规则同源",
      "decision": "日结差异、发票状态和经营指标由同一交易明细模型派生。",
      "rationale": "避免报表与对账使用不同过滤条件，确保金额可以逐笔追溯。",
      "designItemIds": ["design-finance-services"],
      "effectiveStartItemIds": ["effective-start-order-service"],
      "relatedFeatureIds": [
        "feature-payment-reconciliation",
        "feature-einvoice",
        "feature-finance-report"
      ],
      "decisionKind": "OTHER",
      "evidenceIds": []
    },
    {
      "designDecisionId": "decision-production-release",
      "name": "生产切换与业务功能解耦",
      "decision": "使用功能开关、分步切流和可执行回滚清单控制上线。",
      "rationale": "降低全渠道一次性切换风险并形成可签署的生产证据。",
      "designItemIds": ["design-release-platform"],
      "effectiveStartItemIds": ["effective-start-deployment-platform"],
      "relatedFeatureIds": ["feature-production-scope"],
      "decisionKind": "OTHER",
      "evidenceIds": []
    },
    {
      "designDecisionId": "decision-data-migration",
      "name": "迁移与生产切换分别估算",
      "decision": "迁移包含抽取、映射、加载和校验，切换仅负责执行窗口与回滚。",
      "rationale": "防止数据工程工作被隐藏在发布任务中并便于财务核算。",
      "designItemIds": ["design-data-migration"],
      "effectiveStartItemIds": [
        "effective-start-member-master",
        "effective-start-order-service"
      ],
      "relatedFeatureIds": ["feature-data-migration"],
      "decisionKind": "OTHER",
      "evidenceIds": []
    },
    {
      "designDecisionId": "decision-observability-ownership",
      "name": "监控指标与责任人同时交付",
      "decision": "每个核心指标都登记阈值、通知渠道、接收人和处置手册。",
      "rationale": "只有指标没有责任边界无法形成可落地的运营能力。",
      "designItemIds": ["design-observability"],
      "effectiveStartItemIds": ["effective-start-monitoring-platform"],
      "relatedFeatureIds": ["feature-observability-ops"],
      "decisionKind": "OTHER",
      "evidenceIds": []
    },
    {
      "designDecisionId": "decision-quality-layers",
      "name": "按风险分层验证",
      "decision": "自动化回归、人工场景、性能、安全、兼容性和生产烟测分别建账。",
      "rationale": "便于区分 UAT 分母、工程质量活动和生产验证工作量。",
      "designItemIds": ["design-quality"],
      "effectiveStartItemIds": ["effective-start-test-assets"],
      "relatedFeatureIds": ["feature-test-quality", "feature-production-scope"],
      "decisionKind": "OTHER",
      "evidenceIds": []
    }
