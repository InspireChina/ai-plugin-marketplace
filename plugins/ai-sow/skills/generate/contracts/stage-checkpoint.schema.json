{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:generate:next:stage-checkpoint:1",
  "description": "绑定阶段冻结计划、实际执行、完整验证和独立评审通过的不可变证明。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stageKind",
    "inputRevisionSha256",
    "upstreamCheckpointSha256s",
    "stagePlanSha256",
    "effectiveAttemptRecordSha256s",
    "candidateSha256",
    "validatorResultSha256",
    "reviewPacketSha256",
    "reviewDecisionSha256"
  ],
  "properties": {
    "stageKind": {
      "enum": [
        "SCOPE",
        "STORY_AC",
        "TASK"
      ]
    },
    "inputRevisionSha256": {
      "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
    },
    "upstreamCheckpointSha256s": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
      },
      "uniqueItems": true
    },
    "stagePlanSha256": {
      "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
    },
    "effectiveAttemptRecordSha256s": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "candidateSha256": {
      "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
    },
    "validatorResultSha256": {
      "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
    },
    "reviewPacketSha256": {
      "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
    },
    "reviewDecisionSha256": {
      "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
    },
    "priorStateSha256": {
      "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stageKind": {
            "enum": [
              "STORY_AC",
              "TASK"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "priorStateSha256"
          ]
        }
      }
    }
  ]
}
