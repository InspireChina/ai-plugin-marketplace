{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:generate:next:common:1",
  "description": "新生成流水线各合同共享的机器原语、来源引用、诊断、问题与路径哈希定义。",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "name", "plannedEffectiveDate"],
      "properties": {
        "projectId": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/nonEmptyText"},
        "plannedEffectiveDate": {"type": "string", "format": "date"}
      }
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "sha256Array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "blockId", "sha256", "locator"],
      "properties": {
        "sourceId": {"$ref": "#/$defs/id"},
        "blockId": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "locator": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "owner", "retryable", "message", "subjectIds"],
      "properties": {
        "code": {"$ref": "#/$defs/id"},
        "category": {
          "enum": ["INPUT_REQUIRED", "OWNER_FIX_REQUIRED", "CONTRACT_UNSUPPORTED", "SYSTEM_FAILED", "CONTROL"]
        },
        "owner": {
          "enum": ["INPUT", "STAGE_1", "STAGE_2", "STAGE_3", "REVIEW", "PUBLISH", "ORCHESTRATOR"]
        },
        "retryable": {"type": "boolean"},
        "message": {"$ref": "#/$defs/nonEmptyText"},
        "subjectIds": {"$ref": "#/$defs/idArray"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "subjectIds",
        "question",
        "whyAsked",
        "answerDetermines",
        "unansweredConsequence",
        "requiredSourceRole",
        "checkedEvidenceIds"
      ],
      "properties": {
        "questionId": {"$ref": "#/$defs/id"},
        "subjectIds": {"$ref": "#/$defs/idArray"},
        "question": {"$ref": "#/$defs/nonEmptyText"},
        "whyAsked": {"$ref": "#/$defs/nonEmptyText"},
        "answerDetermines": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "unansweredConsequence": {"$ref": "#/$defs/nonEmptyText"},
        "requiredSourceRole": {
          "enum": ["PRD", "DEMO", "APPROVED_DESIGN", "PRIOR_SOW", "SUPPLEMENT", "USER_DECISION"]
        },
        "checkedEvidenceIds": {"$ref": "#/$defs/idArray"}
      }
    },
    "hashPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
