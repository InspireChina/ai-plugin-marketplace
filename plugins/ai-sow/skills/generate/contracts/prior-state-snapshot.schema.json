{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:generate:next:prior-state-snapshot:1",
  "description": "只读往期合同快照；Scope checkpoint 在外部绑定 hash。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "inputRevisionSha256",
    "evidence",
    "entities",
    "sourceRelations",
    "entitySupersessions"
  ],
  "properties": {
    "contractVersion": {
      "const": "prior-state-snapshot-v1"
    },
    "inputRevisionSha256": {
      "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priorEvidenceId",
          "sourceId",
          "workbookSha256",
          "sheet",
          "absoluteA1Range",
          "canonicalCellValuesSha256",
          "canonicalCellValues"
        ],
        "properties": {
          "priorEvidenceId": {
            "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
          },
          "sourceId": {
            "$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"
          },
          "workbookSha256": {
            "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
          },
          "sheet": {
            "type": "string",
            "minLength": 1
          },
          "absoluteA1Range": {
            "type": "string",
            "pattern": "^\\$[A-Z]+\\$[0-9]+:\\$[A-Z]+\\$[0-9]+$"
          },
          "canonicalCellValuesSha256": {
            "$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"
          },
          "canonicalCellValues": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "address",
                "cellType",
                "value",
                "formula",
                "cachedValue"
              ],
              "properties": {
                "address": {
                  "type": "string",
                  "pattern": "^\\$[A-Z]+\\$[0-9]+$"
                },
                "cellType": {
                  "enum": [
                    "n",
                    "s",
                    "inlineStr",
                    "b",
                    "str",
                    "e",
                    "d"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "formula": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "temporalType": {
                  "enum": ["date", "time", "datetime"]
                },
                "cachedValue": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "entityKind",
          "semanticSummary",
          "deliveryStatus",
          "evidenceIds",
          "entityId"
        ],
        "properties": {
          "sourceId": {
            "$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"
          },
          "entityKind": {
            "const": "CONTRACT_ENTITY"
          },
          "semanticSummary": {
            "type": "string",
            "pattern": "\\S"
          },
          "deliveryStatus": {
            "enum": [
              "CURRENT_BY_CONTRACT",
              "EXCLUDED",
              "CANCELLED",
              "NOT_IMPLEMENTED",
              "FUTURE"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"
            }
          },
          "entityId": {
            "$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"
          }
        }
      }
    },
    "sourceRelations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceAId",
          "sourceBId",
          "relation",
          "evidenceIds"
        ],
        "properties": {
          "sourceAId": {
            "$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"
          },
          "sourceBId": {
            "$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"
          },
          "relation": {
            "enum": [
              "DUPLICATE",
              "COMPLEMENTARY",
              "CONFLICT",
              "UNRELATED"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"
            }
          }
        }
      }
    },
    "entitySupersessions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "predecessorIds",
          "successorIds",
          "evidenceIds"
        ],
        "properties": {
          "predecessorIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"
            }
          },
          "successorIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"
            }
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"
            }
          }
        }
      }
    }
  }
}
