{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:generate:next:request:1",
  "description": "记录本轮 SOW 生成意图、项目身份、责任边界和显式输入来源。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "project",
    "mode",
    "responsibilityBoundaries",
    "sources",
    "questions",
    "questionnaireAnswers",
    "currentStateDelta"
  ],
  "properties": {
    "contract": {"const": "ai-sow-generate-request-v2"},
    "project": {"$ref": "#/$defs/project"},
    "mode": {"enum": ["GREENFIELD", "BROWNFIELD"]},
    "responsibilityBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/responsibilityBoundary"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/prdSource"},
          {"$ref": "#/$defs/demoSource"},
          {"$ref": "#/$defs/designSource"},
          {"$ref": "#/$defs/priorSowSource"},
          {"$ref": "#/$defs/supplementSource"}
        ]
      }
    },
    "questions": {
      "type": "array",
      "items": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/question"}
    },
    "questionnaireAnswers": {
      "type": "array",
      "items": {"$ref": "#/$defs/questionnaireAnswer"}
    },
    "currentStateDelta": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/currentStateDelta"}
      ]
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "name", "plannedEffectiveDate"],
      "properties": {
        "projectId": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"},
        "name": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/nonEmptyText"},
        "plannedEffectiveDate": {"type": "string", "format": "date"}
      }
    },
    "responsibilityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responsibilityBoundaryId", "party", "name", "responsibilities"],
      "properties": {
        "responsibilityBoundaryId": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"},
        "party": {"enum": ["VENDOR", "CUSTOMER", "THIRD_PARTY"]},
        "name": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/nonEmptyText"},
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/nonEmptyText"}
        }
      }
    },
    "prdSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "role", "path", "status"],
      "properties": {
        "sourceId": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"},
        "role": {"const": "PRD"},
        "path": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/relativePath"},
        "status": {"const": "APPROVED"}
      }
    },
    "demoSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "role", "path", "status"],
      "properties": {
        "sourceId": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"},
        "role": {"const": "DEMO"},
        "path": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/relativePath"},
        "status": {"enum": ["SELECTED", "NOT_SELECTED"]}
      }
    },
    "designSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "role", "path", "status"],
      "properties": {
        "sourceId": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"},
        "role": {"enum": ["HLD", "ADR"]},
        "path": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/relativePath"},
        "status": {"enum": ["APPROVED", "DRAFT", "REJECTED"]}
      }
    },
    "priorSowSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "role", "path", "status"],
      "properties": {
        "sourceId": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"},
        "role": {"const": "PRIOR_SOW"},
        "path": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/relativePath"},
        "status": {"enum": ["APPLICABLE", "REFERENCE_ONLY"]}
      }
    },
    "supplementSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "role", "path", "status"],
      "properties": {
        "sourceId": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"},
        "role": {"const": "SUPPLEMENT"},
        "path": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/relativePath"},
        "status": {"enum": ["SELECTED", "REFERENCE_ONLY"]}
      }
    },
    "questionnaireAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "questionSha256", "answer"],
      "properties": {
        "questionId": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"},
        "questionSha256": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"},
        "answer": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/nonEmptyText"}
      }
    },
    "currentStateDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "supplementalSourceIds"],
      "properties": {
        "status": {"enum": ["NO_KNOWN_CHANGES", "CHANGES_RECORDED", "UNKNOWN"]},
        "summary": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/nonEmptyText"},
        "supplementalSourceIds": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/idArray"}
      }
    }
  }
}
