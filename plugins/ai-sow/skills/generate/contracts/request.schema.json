{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:generate:next:request:1",
  "description": "记录本轮 SOW 生成意图、项目身份、责任边界和显式输入来源。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "project",
    "mode",
    "responsibilityBoundaries",
    "sources",
    "questions",
    "questionnaireAnswers",
    "declaredChangeContext"
  ],
  "properties": {
    "contract": {"const": "ai-sow-generate-request-v3"},
    "project": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/project"},
    "mode": {"enum": ["GREENFIELD", "BROWNFIELD"]},
    "responsibilityBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/responsibilityBoundary"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceArtifact"}
    },
    "demo": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/demoBundle"}
      ]
    },
    "questions": {
      "type": "array",
      "items": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/question"}
    },
    "questionnaireAnswers": {
      "type": "array",
      "items": {"$ref": "#/$defs/questionnaireAnswer"}
    },
    "declaredChangeContext": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/declaredChangeContext"}
      ]
    }
  },
  "$defs": {
    "demoBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "files"],
      "properties": {
        "entrypoint": {"type": "string", "pattern": "(?i)\\.html$"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/demoFile"}}
      }
    },
    "demoFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "role", "path", "expectedSha256"],
      "properties": {
        "sourceId": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"},
        "role": {"const": "DEMO"},
        "path": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/relativePath"},
        "expectedSha256": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"}
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "role", "path", "expectedSha256"],
      "properties": {
        "sourceId": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"},
        "role": {"enum": ["PRD", "HLD", "ADR", "PRIOR_SOW", "SUPPLEMENT"]},
        "path": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/relativePath"},
        "expectedSha256": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"}
      }
    },
    "responsibilityBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responsibilityBoundaryId", "party", "name", "responsibilities"],
      "properties": {
        "responsibilityBoundaryId": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"},
        "party": {"enum": ["VENDOR", "CUSTOMER", "THIRD_PARTY"]},
        "name": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/nonEmptyText"},
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/nonEmptyText"}
        }
      }
    },
    "questionnaireAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "questionSha256", "answer"],
      "properties": {
        "questionId": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/id"},
        "questionSha256": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/sha256"},
        "answer": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/nonEmptyText"}
      }
    },
    "declaredChangeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "supplementalSourceIds"],
      "properties": {
        "status": {"enum": ["NO_KNOWN_CHANGES", "CHANGES_RECORDED", "UNKNOWN"]},
        "summary": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/nonEmptyText"},
        "supplementalSourceIds": {"$ref": "urn:ai-sow:generate:next:common:1#/$defs/idArray"}
      }
    }
  }
}
