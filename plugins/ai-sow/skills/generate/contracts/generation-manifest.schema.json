{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:generate:generation-manifest:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "generationId",
    "revisionId",
    "inputManifestPath",
    "inputManifestSha256",
    "scopePath",
    "scopeSha256",
    "deliveryPath",
    "deliverySha256",
    "templatePath",
    "templateSha256",
    "workbookPath",
    "workbookSha256",
    "notesPath",
    "notesSha256",
    "scopeCompilerContract",
    "deliveryCompilerContract",
    "rendererContract",
    "decision",
    "reviewMode",
    "impact",
    "changeCounts",
    "finalReview",
    "finalReviewSha256",
    "publicationComplete"
  ],
  "properties": {
    "contract": {"const": "ai-sow-generation-manifest-v1"},
    "generationId": {"type": "string", "pattern": "^[0-9]{6}$"},
    "revisionId": {"type": "string", "pattern": "^[0-9]{6}$"},
    "inputManifestPath": {"$ref": "urn:ai-sow:generate:common:1#/$defs/projectRelativePath"},
    "inputManifestSha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "scopePath": {"$ref": "urn:ai-sow:generate:common:1#/$defs/projectRelativePath"},
    "scopeSha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "deliveryPath": {"$ref": "urn:ai-sow:generate:common:1#/$defs/projectRelativePath"},
    "deliverySha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "templatePath": {"$ref": "urn:ai-sow:generate:common:1#/$defs/projectRelativePath"},
    "templateSha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "workbookPath": {"$ref": "urn:ai-sow:generate:common:1#/$defs/projectRelativePath"},
    "workbookSha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "notesPath": {"$ref": "urn:ai-sow:generate:common:1#/$defs/projectRelativePath"},
    "notesSha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "scopeCompilerContract": {"const": "scope-compiler-v1"},
    "deliveryCompilerContract": {"const": "delivery-compiler-v1"},
    "rendererContract": {"const": "generation-renderer-v1"},
    "decision": {"type": "string", "enum": ["PASS", "PASS_WITH_NOTES"]},
    "reviewMode": {"type": "string", "enum": ["AUTOMATIC_FINAL_REVIEW", "REUSED_SCOPE_REVIEW"]},
    "impact": {"$ref": "urn:ai-sow:generate:run-plan:1#/$defs/impact"},
    "changeCounts": {"$ref": "#/$defs/changeCounts"},
    "finalReview": {"$ref": "urn:ai-sow:generate:final-review:1"},
    "finalReviewSha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "publicationComplete": {"const": true}
  },
  "$defs": {
    "changeCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "recomputedStories", "recomputedTasks"],
      "properties": {
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["added", "updated", "removed"],
          "properties": {
            "added": {"type": "integer", "minimum": 0},
            "updated": {"type": "integer", "minimum": 0},
            "removed": {"type": "integer", "minimum": 0}
          }
        },
        "recomputedStories": {"type": "integer", "minimum": 0},
        "recomputedTasks": {"type": "integer", "minimum": 0}
      }
    }
  }
}
