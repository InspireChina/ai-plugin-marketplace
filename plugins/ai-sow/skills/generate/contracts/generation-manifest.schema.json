{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:generate:generation-manifest:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "generationId",
    "revisionId",
    "inputManifestPath",
    "inputManifestSha256",
    "scopePath",
    "scopeSha256",
    "deliveryPath",
    "deliverySha256",
    "templatePath",
    "templateSha256",
    "workbookPath",
    "workbookSha256",
    "notesPath",
    "notesSha256",
    "scopeCompilerContract",
    "deliveryCompilerContract",
    "rendererContract",
    "decision",
    "reviewMode",
    "impact",
    "changeCounts",
    "finalReview",
    "finalReviewSha256",
    "publicationComplete"
  ],
  "properties": {
    "contract": {"const": "ai-sow-generation-manifest-v1"},
    "generationId": {"type": "string", "pattern": "^[0-9]{6}$"},
    "revisionId": {"type": "string", "pattern": "^[0-9]{6}$"},
    "inputManifestPath": {"$ref": "urn:ai-sow:generate:common:1#/$defs/projectRelativePath"},
    "inputManifestSha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "scopePath": {"$ref": "urn:ai-sow:generate:common:1#/$defs/projectRelativePath"},
    "scopeSha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "deliveryPath": {"$ref": "urn:ai-sow:generate:common:1#/$defs/projectRelativePath"},
    "deliverySha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "templatePath": {"$ref": "urn:ai-sow:generate:common:1#/$defs/projectRelativePath"},
    "templateSha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "workbookPath": {"$ref": "urn:ai-sow:generate:common:1#/$defs/projectRelativePath"},
    "workbookSha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "workbookVerification": {"$ref": "#/$defs/workbookVerification"},
    "notesPath": {"$ref": "urn:ai-sow:generate:common:1#/$defs/projectRelativePath"},
    "notesSha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "scopeCompilerContract": {"enum": ["scope-compiler-v1", "scope-compiler-v2"]},
    "deliveryCompilerContract": {"enum": ["delivery-compiler-v1", "delivery-compiler-v2", "delivery-compiler-v3", "delivery-compiler-v4", "delivery-compiler-v5"]},
    "rendererContract": {
      "enum": ["generation-renderer-v1", "generation-renderer-v2", "generation-renderer-v3", "generation-renderer-v4", "generation-renderer-v5", "generation-renderer-v6", "generation-renderer-v7"]
    },
    "decision": {"type": "string", "enum": ["PASS", "PASS_WITH_NOTES"]},
    "reviewMode": {"type": "string", "enum": ["AUTOMATIC_FINAL_REVIEW", "REUSED_SCOPE_REVIEW"]},
    "impact": {"$ref": "urn:ai-sow:generate:run-plan:1#/$defs/impact"},
    "changeCounts": {},
    "finalReview": {"$ref": "urn:ai-sow:generate:final-review:1"},
    "finalReviewSha256": {"$ref": "urn:ai-sow:generate:common:1#/$defs/sha256"},
    "publicationComplete": {"const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {"rendererContract": {"const": "generation-renderer-v1"}},
        "required": ["rendererContract"]
      },
      "then": {
        "not": {"required": ["workbookVerification"]},
        "properties": {
          "scopeCompilerContract": {"const": "scope-compiler-v1"},
          "deliveryCompilerContract": {"const": "delivery-compiler-v1"},
          "rendererContract": {"const": "generation-renderer-v1"},
          "changeCounts": {"$ref": "#/$defs/legacyChangeCounts"}
        }
      },
      "else": {
        "required": ["workbookVerification"],
        "properties": {
          "scopeCompilerContract": {"const": "scope-compiler-v2"},
          "deliveryCompilerContract": {"enum": ["delivery-compiler-v2", "delivery-compiler-v3", "delivery-compiler-v4", "delivery-compiler-v5"]},
          "rendererContract": {"enum": ["generation-renderer-v2", "generation-renderer-v3", "generation-renderer-v4", "generation-renderer-v5", "generation-renderer-v6", "generation-renderer-v7"]},
          "changeCounts": {"$ref": "#/$defs/changeCounts"}
        }
      }
    }
  ],
  "$defs": {
    "workbookVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trustState",
        "engine",
        "storyCount",
        "taskCount",
        "directDays",
        "sitDays",
        "uatDays",
        "totalDays",
        "parameterStatuses",
        "formulaErrors"
      ],
      "properties": {
        "trustState": {"const": "VERIFIED"},
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "storyCount": {"type": "integer", "minimum": 1},
        "taskCount": {"type": "integer", "minimum": 1},
        "directDays": {"type": "number", "minimum": 0},
        "sitDays": {"type": "number", "minimum": 0},
        "uatDays": {"type": "number", "minimum": 0},
        "totalDays": {"type": "number", "minimum": 0},
        "parameterStatuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "status"],
            "properties": {
              "code": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1}
            }
          }
        },
        "formulaErrors": {"type": "array", "maxItems": 0}
      }
    },
    "changeCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "stories", "acceptanceCriteria", "tasks"],
      "properties": {
        "features": {"$ref": "#/$defs/collectionCounts"},
        "stories": {"$ref": "#/$defs/collectionCounts"},
        "acceptanceCriteria": {"$ref": "#/$defs/collectionCounts"},
        "tasks": {"$ref": "#/$defs/collectionCounts"}
      }
    },
    "legacyChangeCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "recomputedStories", "recomputedTasks"],
      "properties": {
        "features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["added", "updated", "removed"],
          "properties": {
            "added": {"type": "integer", "minimum": 0},
            "updated": {"type": "integer", "minimum": 0},
            "removed": {"type": "integer", "minimum": 0}
          }
        },
        "recomputedStories": {"type": "integer", "minimum": 0},
        "recomputedTasks": {"type": "integer", "minimum": 0}
      }
    },
    "collectionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected", "recomputed", "reused", "deleted", "final"],
      "properties": {
        "affected": {"type": "integer", "minimum": 0},
        "recomputed": {"type": "integer", "minimum": 0},
        "reused": {"type": "integer", "minimum": 0},
        "deleted": {"type": "integer", "minimum": 0},
        "final": {"type": "integer", "minimum": 0}
      }
    }
  }
}
