{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:analyze-as-is:asis:0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysisScope",
    "topicAssessments",
    "items",
    "commitments",
    "effectiveStartItems",
    "coverage",
    "uncertainties",
    "evidence"
  ],
  "properties": {
    "analysisScope": {"$ref": "#/$defs/analysisScope", "description": "本次现状调查的模式、时点、登记输入和明确的包含与排除边界。"},
    "topicAssessments": {"type": "array", "items": {"$ref": "#/$defs/topicAssessment"}, "description": "按权威顺序覆盖九个 Topic 的评估结论及其不确定性。"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}, "description": "由当前证据确认、属于 As-Is Owner 的现有能力、组件、集成、资产、控制或约束。"},
    "commitments": {"type": "array", "items": {"$ref": "#/$defs/commitment"}, "description": "从已登记往期 SOW 中提取并核实现状和处置的承诺。"},
    "effectiveStartItems": {"type": "array", "items": {"$ref": "#/$defs/effectiveStartItem"}, "description": "项目启动时可作为实际起点的当前 Item 与预期启动前承诺组合。"},
    "coverage": {"type": "array", "items": {"$ref": "#/$defs/coverage"}, "description": "每个获批 BUSINESS Feature 与现状起点、承诺、缺口和不确定性的覆盖关系。"},
    "uncertainties": {"type": "array", "items": {"$ref": "#/$defs/uncertainty"}, "description": "直接调查后仍未解决且可能影响设计、范围或估算的现状问题。"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "description": "支撑 As-Is 结论的项目相对证据索引，不保存源码或完整工具输出。"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"},
    "asIsItemId": {"type": "string", "pattern": "^asis-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "commitmentId": {"type": "string", "pattern": "^commitment-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "effectiveStartItemId": {"type": "string", "pattern": "^effective-start-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "uncertaintyId": {"type": "string", "pattern": "^uncertainty-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "evidenceId": {"type": "string", "pattern": "^evidence-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "featureId": {"type": "string", "pattern": "^feature-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "projectRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2})(?:/|$))[^\\r\\n/]+(?:/[^\\r\\n/]+)*$"
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "asIsItemIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/asIsItemId"}
    },
    "commitmentIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/commitmentId"}
    },
    "effectiveStartItemIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/effectiveStartItemId"}
    },
    "uncertaintyIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/uncertaintyId"}
    },
    "featureIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/featureId"}
    },
    "supportedId": {
      "anyOf": [
        {"$ref": "#/$defs/asIsItemId"},
        {"$ref": "#/$defs/commitmentId"},
        {"$ref": "#/$defs/effectiveStartItemId"},
        {"$ref": "#/$defs/uncertaintyId"},
        {"$ref": "#/$defs/featureId"}
      ]
    },
    "supportedIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/supportedId"}
    },
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "stableReference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\r\\n])(?![Ff][Ii][Ll][Ee]:)(?:[a-z][a-z0-9-]*:)?(?!\\.{1,2}(?:/|#|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|#|$))[A-Za-z0-9._-]+)*(?:#[A-Za-z0-9._~:/?@!$&'()*+,%=-]+)?$"
    },
    "topic": {
      "type": "string",
      "enum": [
        "SYSTEM_CONTEXT",
        "CAPABILITY",
        "APPLICATION",
        "INTEGRATION",
        "DATA",
        "PLATFORM",
        "SECURITY_COMPLIANCE",
        "OPERATIONS_QUALITY",
        "DELIVERY_CONSTRAINTS"
      ]
    },
    "itemType": {
      "type": "string",
      "enum": [
        "CAPABILITY",
        "COMPONENT",
        "INTEGRATION",
        "DATA_ASSET",
        "INFRASTRUCTURE",
        "CONTROL",
        "PROCESS",
        "CONSTRAINT"
      ]
    },
    "repositorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoId", "name", "path", "revision", "dirty"],
      "properties": {
        "repoId": {"$ref": "#/$defs/id", "description": "本次调查内稳定识别该代码库的 ID，供 Item 与 Evidence anchor 使用。"},
        "name": {"$ref": "#/$defs/nonEmptyString", "description": "面向评审展示的非空代码库名称。"},
        "path": {
          "anyOf": [
            {"const": "."},
            {"$ref": "#/$defs/projectRelativePath"}
          ],
          "description": "用户提供或授权调查的代码库项目相对目录；项目根目录使用点号。"
        },
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$", "description": "调查时登记的代码库完整 revision，用于固定证据所对应的版本。"},
        "dirty": {"type": "boolean", "description": "调查时工作树是否包含未提交变化，提醒评审证据是否超出 revision。"}
      }
    },
    "priorSowSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priorSowId", "name", "file", "originalName", "sha256"],
      "properties": {
        "priorSowId": {"$ref": "#/$defs/id", "description": "本次调查内稳定识别往期 SOW 的 ID，供 Commitment 引用。"},
        "name": {"$ref": "#/$defs/nonEmptyString", "description": "面向评审展示的非空往期 SOW 名称。"},
        "file": {
          "allOf": [
            {"$ref": "#/$defs/projectRelativePath"},
            {"pattern": "^\\.ai-sow/inputs/analyze-as-is/prior-sows/.+"}
          ],
          "description": "复制到本 Skill 输入目录的往期 SOW 项目相对路径。"
        },
        "originalName": {"$ref": "#/$defs/nonEmptyString", "description": "用户提供时的原文件名，用于评审辨识来源。"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "往期 SOW 原字节的 SHA-256，用于证明承诺核对针对同一输入。"}
      }
    },
    "analysisScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "asOfDate", "repositorySnapshots", "priorSowSnapshots", "includedSystems", "includedAreas", "excludedAreas"],
      "properties": {
        "mode": {"type": "string", "enum": ["GREENFIELD", "BROWNFIELD"], "description": "依据是否存在需要调查的当前系统或往期承诺确定的现状模式。"},
        "asOfDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "全部现状结论共同适用的调查截止日期。"},
        "repositorySnapshots": {
          "type": "array",
          "items": {"$ref": "#/$defs/repositorySnapshot"},
          "description": "本次 Brownfield 调查实际登记的代码库快照；Greenfield 时为空。"
        },
        "priorSowSnapshots": {
          "type": "array",
          "items": {"$ref": "#/$defs/priorSowSnapshot"},
          "description": "本次实际核对的往期 SOW 输入快照；没有往期承诺时为空。"
        },
        "includedSystems": {"$ref": "#/$defs/stringArray", "description": "明确纳入调查和现状结论的系统边界。"},
        "includedAreas": {"$ref": "#/$defs/stringArray", "description": "明确纳入调查的能力、流程、数据或技术区域。"},
        "excludedAreas": {"$ref": "#/$defs/stringArray", "description": "经评审明确不属于本次现状调查的区域及边界。"}
      }
    },
    "topicAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "status", "summary", "uncertaintyIds"],
      "properties": {
        "topic": {"$ref": "#/$defs/topic", "description": "当前评估对应的权威现状 Topic。"},
        "status": {
          "type": "string",
          "enum": [
            "RELEVANT_INVESTIGATED",
            "RELEVANT_INSUFFICIENT_EVIDENCE",
            "BOUNDARY_DECLARED",
            "NOT_APPLICABLE"
          ],
          "description": "两层调查结论：九项必须表态，只有影响估算且已调查的 Topic 才要求深度取证。"
        },
        "summary": {"$ref": "#/$defs/nonEmptyString", "description": "对该 Topic 当前状态、适用边界或证据不足的简明专业结论。"},
        "uncertaintyIds": {"$ref": "#/$defs/uncertaintyIdArray", "description": "相关 Topic 的 As-Is Uncertainty ID；估算相关缺口必须为 affectsEstimate=true，边界声明必须为 false。"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asIsItemId", "topic", "itemType", "name", "summary", "repositoryIds"],
      "properties": {
        "asIsItemId": {"$ref": "#/$defs/asIsItemId", "description": "由 As-Is Owner 维护的当前 Item 稳定 ID。"},
        "topic": {"$ref": "#/$defs/topic", "description": "最能表达该 Item 当前性质的现状 Topic。"},
        "itemType": {"$ref": "#/$defs/itemType", "description": "当前事实所属的能力、组件、集成、数据、基础设施、控制、流程或约束类别。"},
        "name": {"$ref": "#/$defs/nonEmptyString", "description": "便于业务与技术评审共同识别的当前 Item 名称。"},
        "summary": {"$ref": "#/$defs/nonEmptyString", "description": "证据能够支持的当前行为、责任和边界，不写目标设计或待交付范围。"},
        "repositoryIds": {"$ref": "#/$defs/idArray", "description": "直接支撑该 Item 的已登记 repository snapshot ID；非代码事实可为空。"},
        "source": {"$ref": "#/$defs/nonEmptyString", "description": "集成当前接收信息或调用的来源；仅 INTEGRATION Item 生成。"},
        "target": {"$ref": "#/$defs/nonEmptyString", "description": "集成当前发送信息或调用的目标；仅 INTEGRATION Item 生成。"},
        "trigger": {"$ref": "#/$defs/nonEmptyString", "description": "触发当前集成交换的事件、调用、计划或人工动作；仅 INTEGRATION Item 生成。"},
        "direction": {"type": "string", "enum": ["INBOUND", "OUTBOUND"], "description": "相对于范围内系统的当前集成方向；仅 INTEGRATION Item 生成。"},
        "purpose": {"$ref": "#/$defs/nonEmptyString", "description": "当前集成交换所服务的业务或运营目的；仅 INTEGRATION Item 生成。"},
        "owner": {"$ref": "#/$defs/nonEmptyString", "description": "对当前集成边界、合同或运行负责的团队；仅 INTEGRATION Item 生成。"}
      },
      "if": {
        "properties": {"itemType": {"const": "INTEGRATION"}},
        "required": ["itemType"]
      },
      "then": {"required": ["source", "target", "trigger", "direction", "purpose", "owner"]},
      "else": {
        "properties": {
          "source": false,
          "target": false,
          "trigger": false,
          "direction": false,
          "purpose": false,
          "owner": false
        }
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitmentId",
        "priorSowId",
        "sourceReference",
        "topic",
        "changeType",
        "name",
        "summary",
        "implementationStatus",
        "treatment",
        "affectedItemIds",
        "relatedFeatureIds"
      ],
      "properties": {
        "commitmentId": {"$ref": "#/$defs/commitmentId", "description": "由 As-Is Owner 维护的往期承诺稳定 ID。"},
        "priorSowId": {"$ref": "#/$defs/id", "description": "产生该承诺的已登记往期 SOW ID。"},
        "sourceReference": {"$ref": "#/$defs/stableReference", "description": "往期 SOW 中可复核该承诺的单一稳定逻辑 anchor。"},
        "topic": {"$ref": "#/$defs/topic", "description": "该往期承诺主要影响的现状 Topic。"},
        "changeType": {"type": "string", "enum": ["ADD", "REPLACE", "RETIRE"], "description": "往期承诺对当时基线提出的新增、替换或退役意图。"},
        "name": {"$ref": "#/$defs/nonEmptyString", "description": "便于与往期 SOW 和当前范围核对的承诺名称。"},
        "summary": {"$ref": "#/$defs/nonEmptyString", "description": "用简明语言保留往期承诺的交付含义，不复制原文。"},
        "implementationStatus": {
          "type": "string",
          "enum": ["IMPLEMENTED", "PARTIAL", "NOT_IMPLEMENTED", "UNVERIFIED", "SUPERSEDED"],
          "description": "依据当前证据核对出的承诺实现状态。"
        },
        "treatment": {
          "type": "string",
          "enum": ["CURRENT_BASELINE", "EXPECTED_BEFORE_START", "CARRY_FORWARD", "EXCLUDE", "NEEDS_DECISION"],
          "description": "该承诺在当前 SOW 起点与范围中的处置结论。"
        },
        "affectedItemIds": {"$ref": "#/$defs/asIsItemIdArray", "description": "已由该承诺实现或部分影响的当前 As-Is Item ID。"},
        "relatedFeatureIds": {"$ref": "#/$defs/featureIdArray", "description": "承诺处置会影响的获批 BUSINESS Feature ID。"}
      }
    },
    "effectiveStartItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectiveStartItemId", "topic", "itemType", "name", "summary", "sourceItemIds", "commitmentIds"],
      "properties": {
        "effectiveStartItemId": {"$ref": "#/$defs/effectiveStartItemId", "description": "由 As-Is Owner 维护的有效起点稳定 ID。"},
        "topic": {"$ref": "#/$defs/topic", "description": "该有效起点主要所属的现状 Topic。"},
        "itemType": {"$ref": "#/$defs/itemType", "description": "有效起点所代表的事实类别，与其来源 Item 或承诺保持语义一致。"},
        "name": {"$ref": "#/$defs/nonEmptyString", "description": "供后续设计识别和引用的有效起点名称。"},
        "summary": {"$ref": "#/$defs/nonEmptyString", "description": "说明项目启动时预计已经存在且可依赖的能力、组件或边界。"},
        "sourceItemIds": {"$ref": "#/$defs/asIsItemIdArray", "description": "共同构成该有效起点的当前 As-Is Item ID。"},
        "commitmentIds": {"$ref": "#/$defs/commitmentIdArray", "description": "预计启动前完成并共同构成起点的 Commitment ID；不得引用 CARRY_FORWARD。"}
      },
      "anyOf": [
        {"properties": {"sourceItemIds": {"minItems": 1}}},
        {"properties": {"commitmentIds": {"minItems": 1}}}
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureId", "status", "effectiveStartItemIds", "commitmentIds", "uncertaintyIds", "rationale"],
      "properties": {
        "featureId": {"$ref": "#/$defs/featureId", "description": "当前覆盖结论对应的获批 BUSINESS Feature ID。"},
        "status": {"type": "string", "enum": ["COMPLETE", "PARTIAL", "MISSING"], "description": "有效起点对该 Feature 的现有覆盖程度，不表示目标实现状态。"},
        "effectiveStartItemIds": {"$ref": "#/$defs/effectiveStartItemIdArray", "description": "对该 Feature 提供当前覆盖的 Effective Start Item ID。"},
        "commitmentIds": {"$ref": "#/$defs/commitmentIdArray", "description": "与该 Feature 相关且需要在范围判断中保留的往期 Commitment ID。"},
        "uncertaintyIds": {"$ref": "#/$defs/uncertaintyIdArray", "description": "使该 Feature 当前覆盖仍不确定的 As-Is Uncertainty ID。"},
        "rationale": {"$ref": "#/$defs/nonEmptyString", "description": "综合有效起点、承诺、证据和缺口解释覆盖状态的具体理由。"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"enum": ["COMPLETE", "PARTIAL"]}},
            "required": ["status"]
          },
          "then": {"properties": {"effectiveStartItemIds": {"minItems": 1}}}
        },
        {
          "if": {
            "properties": {"status": {"const": "MISSING"}},
            "required": ["status"]
          },
          "then": {"properties": {"effectiveStartItemIds": {"maxItems": 0}}}
        }
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncertaintyId", "name", "topic", "question", "impact", "affectsEstimate", "owner", "recommendedHandling", "relatedFeatureIds"],
      "properties": {
        "uncertaintyId": {"$ref": "#/$defs/uncertaintyId", "description": "由 As-Is Owner 维护的未解决现状问题稳定 ID。"},
        "name": {"$ref": "#/$defs/nonEmptyString", "description": "面向评审展示的不确定性名称。"},
        "topic": {"$ref": "#/$defs/topic", "description": "该不确定性主要阻碍形成结论的现状 Topic。"},
        "question": {"$ref": "#/$defs/nonEmptyString", "description": "需要由进一步证据或负责人回答的具体、可决策问题。"},
        "impact": {"$ref": "#/$defs/nonEmptyString", "description": "未解决答案可能改变的范围、责任、设计、交付对象或工作量。"},
        "affectsEstimate": {"type": "boolean", "description": "答案是否可能改变正式估算；只有确认不影响时才为否。"},
        "owner": {"$ref": "#/$defs/nonEmptyString", "description": "负责提供证据、作出决定或推动解决的人员、团队或角色。"},
        "recommendedHandling": {"$ref": "#/$defs/nonEmptyString", "description": "建议的解决动作、最晚决策关卡或安全处置方式。"},
        "relatedFeatureIds": {"$ref": "#/$defs/featureIdArray", "description": "答案可能影响的获批 BUSINESS Feature ID。"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "name", "kind", "reference", "summary", "supportsIds"],
      "properties": {
        "evidenceId": {"$ref": "#/$defs/evidenceId", "description": "由 As-Is Owner 维护的证据索引稳定 ID。"},
        "name": {"$ref": "#/$defs/nonEmptyString", "description": "面向评审展示的非空证据名称。"},
        "kind": {
          "type": "string",
          "enum": ["RUNTIME", "CONTRACT", "CONFIGURATION", "CODE", "DEPLOYMENT", "PRIOR_SOW", "QUESTIONNAIRE", "DOCUMENT"],
          "description": "直接证据的来源类别，用于限定它能够支持的现状结论。"
        },
        "runtimeOutcome": {
          "type": "string",
          "enum": ["PASSED", "FAILED", "BLOCKED"],
          "description": "定向运行验证实际得到的结果；仅 RUNTIME Evidence 生成。"
        },
        "reference": {"$ref": "#/$defs/stableReference", "description": "可复核证据的单一项目相对或合同逻辑 anchor，不包含绝对路径和原始内容。"},
        "summary": {"$ref": "#/$defs/nonEmptyString", "description": "说明证据直接观察到的事实及边界，不扩大到未覆盖结论。"},
        "supportsIds": {"$ref": "#/$defs/supportedIdArray", "description": "该证据直接支撑的 Item、Commitment、Effective Start、Uncertainty 或 Feature ID。"}
      },
      "if": {
        "properties": {"kind": {"const": "RUNTIME"}},
        "required": ["kind"]
      },
      "then": {"required": ["runtimeOutcome"]},
      "else": {"properties": {"runtimeOutcome": false}}
    }
  }
}
