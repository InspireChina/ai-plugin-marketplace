{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:generate-task:estimate:0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "description": "按一个基础单元实例一行拆分的可估算 Task 清单。",
      "type": "array",
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"},
    "taskId": {"type": "string", "pattern": "^task-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "idArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "complexity": {"type": "string", "enum": ["S", "M", "L"]},
    "workModeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectiveStartItemId", "effectiveStartItemName"],
      "properties": {
        "effectiveStartItemId": {
          "description": "支撑调整或接入复用判断的 Effective Start 稳定记录 ID。",
          "$ref": "#/$defs/id"
        },
        "effectiveStartItemName": {
          "description": "与 Effective Start 稳定记录完全一致的对象名称。",
          "type": "string",
          "minLength": 1
        },
        "projectSideWorkTypes": {
          "description": "接入复用时本项目侧可独立估算并承诺交付的工作类型。",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["REGISTER", "CONFIGURE", "WRAP", "MAP", "ADAPT", "AUTHENTICATE", "TENANT_SETUP", "PERMISSION_SETUP", "SPECIALIZED_VERIFY"]
          }
        },
        "projectSideWorkCommitment": {
          "description": "按工作类型枚举顺序生成的本项目侧交付承诺。",
          "type": "string",
          "pattern": "^本项目负责并交付：(?:注册|配置|封装|映射|适配|认证|租户设置|权限设置|专项验证)(?:、(?:注册|配置|封装|映射|适配|认证|租户设置|权限设置|专项验证))*$"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "storyId", "acceptanceCriterionIds", "name", "baseUnit", "workMode", "workModeRationale", "complexity", "matchedEffectiveStartItemIds", "rationale"],
      "properties": {
        "taskId": {
          "description": "当前 Skill 创建且语义稳定的 Task ID。",
          "$ref": "#/$defs/taskId"
        },
        "storyId": {
          "description": "该 Task 所实现的上游 Story ID。",
          "$ref": "#/$defs/id"
        },
        "acceptanceCriterionIds": {
          "description": "该 Task 所支持的同 Story 验收条件 ID；AC 与 Task 允许多对多追溯。",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "name": {
          "description": "明确交付对象和单个基础单元实例边界的 Task 名称。",
          "type": "string",
          "minLength": 1
        },
        "baseUnit": {
          "description": "项目模板基础单元目录中的基础单元 ID。",
          "type": "string",
          "minLength": 1
        },
        "workMode": {
          "description": "当前实例相对 Effective Start 的工作模式。",
          "type": "string",
          "enum": ["新建", "调整", "接入复用"]
        },
        "workModeRationale": {
          "description": "结合当前实例和现状说明工作模式选择的具体理由；接入复用时精确使用 <effectiveStartItemName>保持不变；<projectSideWorkCommitment>。",
          "type": "string",
          "minLength": 1
        },
        "workModeEvidence": {
          "description": "调整或接入复用所依赖的结构化现状证据。",
          "$ref": "#/$defs/workModeEvidence"
        },
        "complexity": {
          "description": "依据当前基础单元标准选择的 S、M 或 L 复杂度。",
          "$ref": "#/$defs/complexity"
        },
        "complexityRationale": {
          "description": "S 或 L 实例偏离 M 档标准的具体事实。",
          "type": "string",
          "minLength": 1
        },
        "integrationId": {
          "description": "仅集成 Task 使用且与其一对一对应的上游 Integration ID。",
          "$ref": "#/$defs/id"
        },
        "matchedEffectiveStartItemIds": {
          "$ref": "#/$defs/idArray",
          "description": "投影到任务明细并与系统现状 EFFECTIVE_START 记录匹配的稳定 ID。"
        },
        "rationale": {
          "description": "说明单实例计数边界、包含和排除范围的判断依据。",
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"complexity": {"enum": ["S", "L"]}},
            "required": ["complexity"]
          },
          "then": {"required": ["complexityRationale"]},
          "else": {"not": {"required": ["complexityRationale"]}}
        },
        {
          "if": {
            "properties": {"workMode": {"enum": ["调整", "接入复用"]}},
            "required": ["workMode"]
          },
          "then": {"required": ["workModeEvidence"]},
          "else": {"not": {"required": ["workModeEvidence"]}}
        },
        {
          "if": {
            "properties": {"workMode": {"const": "接入复用"}},
            "required": ["workMode"]
          },
          "then": {
            "properties": {
              "workModeEvidence": {
                "allOf": [
                  {"$ref": "#/$defs/workModeEvidence"},
                  {"required": ["projectSideWorkTypes", "projectSideWorkCommitment"]}
                ]
              }
            }
          },
          "else": {
            "properties": {
              "workModeEvidence": {
                "allOf": [
                  {"$ref": "#/$defs/workModeEvidence"},
                  {
                    "not": {
                      "anyOf": [
                        {"required": ["projectSideWorkTypes"]},
                        {"required": ["projectSideWorkCommitment"]}
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
