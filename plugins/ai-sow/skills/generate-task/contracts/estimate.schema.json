{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:generate-task:estimate:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks"],
  "properties": {
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"},
    "taskId": {"type": "string", "pattern": "^task-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "idArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "complexity": {"type": "string", "enum": ["S", "M", "L"]},
    "workModeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effectiveStartItemId", "effectiveStartItemName"],
      "properties": {
        "effectiveStartItemId": {"$ref": "#/$defs/id"},
        "effectiveStartItemName": {"type": "string", "minLength": 1},
        "projectSideWorkTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["REGISTER", "CONFIGURE", "WRAP", "MAP", "ADAPT", "AUTHENTICATE", "TENANT_SETUP", "PERMISSION_SETUP", "SPECIALIZED_VERIFY"]
          }
        },
        "projectSideWorkCommitment": {
          "type": "string",
          "pattern": "^本项目负责并交付：(?:注册|配置|封装|映射|适配|认证|租户设置|权限设置|专项验证)(?:、(?:注册|配置|封装|映射|适配|认证|租户设置|权限设置|专项验证))*$"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "storyId", "name", "baseUnit", "workMode", "workModeRationale", "complexity", "matchedEffectiveStartItemIds", "rationale"],
      "properties": {
        "taskId": {"$ref": "#/$defs/taskId"},
        "storyId": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "baseUnit": {"type": "string", "minLength": 1},
        "workMode": {"type": "string", "enum": ["新建", "调整", "接入复用"]},
        "workModeRationale": {"type": "string", "minLength": 1},
        "workModeEvidence": {"$ref": "#/$defs/workModeEvidence"},
        "complexity": {"$ref": "#/$defs/complexity"},
        "complexityRationale": {"type": "string", "minLength": 1},
        "integrationId": {"$ref": "#/$defs/id"},
        "matchedEffectiveStartItemIds": {
          "$ref": "#/$defs/idArray",
          "description": "Stable Effective Start record IDs projected to 05-任务明细!K 系统现状匹配 and matched to 90-系统现状 EFFECTIVE_START 记录 ID rows."
        },
        "rationale": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"complexity": {"enum": ["S", "L"]}},
            "required": ["complexity"]
          },
          "then": {"required": ["complexityRationale"]},
          "else": {"not": {"required": ["complexityRationale"]}}
        },
        {
          "if": {
            "properties": {"workMode": {"enum": ["调整", "接入复用"]}},
            "required": ["workMode"]
          },
          "then": {"required": ["workModeEvidence"]},
          "else": {"not": {"required": ["workModeEvidence"]}}
        },
        {
          "if": {
            "properties": {"workMode": {"const": "接入复用"}},
            "required": ["workMode"]
          },
          "then": {
            "properties": {
              "workModeEvidence": {
                "allOf": [
                  {"$ref": "#/$defs/workModeEvidence"},
                  {"required": ["projectSideWorkTypes", "projectSideWorkCommitment"]}
                ]
              }
            }
          },
          "else": {
            "properties": {
              "workModeEvidence": {
                "allOf": [
                  {"$ref": "#/$defs/workModeEvidence"},
                  {
                    "not": {
                      "anyOf": [
                        {"required": ["projectSideWorkTypes"]},
                        {"required": ["projectSideWorkCommitment"]}
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
