{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:generate-design:design:0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["designItems", "architectureDeltas", "decisions", "scopeDecisions"],
  "properties": {
    "designItems": {"type": "array", "items": {"$ref": "#/$defs/designItem"}, "description": "构成获批目标方案并可被范围、决策或架构变化引用的设计实体。"},
    "architectureDeltas": {"type": "array", "items": {"$ref": "#/$defs/architectureDelta"}, "description": "目标方案相对 Effective Start 的新增、采用、调整、替换或退役变化。"},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}, "description": "目标设计中已评审的技术选择、理由、证据和受影响范围。"},
    "scopeDecisions": {"type": "array", "items": {"$ref": "#/$defs/scopeDecision"}, "description": "每个 BUSINESS 与 TECHNICAL Feature 的交付处置和设计覆盖义务。"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"},
    "idArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nonEmptyIdArray": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "designItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designItemId", "type", "name", "summary"],
      "properties": {
        "designItemId": {"$ref": "#/$defs/id", "description": "由 Design Owner 维护并供范围、决策和架构变化引用的稳定 ID。"},
        "type": {"type": "string", "enum": ["COMPONENT", "FLOW", "DATA", "INTEGRATION", "INFRASTRUCTURE", "QUALITY"], "description": "目标设计实体在组件、流程、数据、集成、基础设施或质量方面的主要性质。"},
        "name": {"type": "string", "minLength": 1, "description": "便于业务与技术评审共同识别的目标设计名称。"},
        "summary": {"type": "string", "minLength": 1, "description": "该设计实体在目标方案中的职责、边界和预期行为。"}
      }
    },
    "architectureDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architectureDeltaId", "name", "changeType", "designItemId", "effectiveStartItemIds", "summary"],
      "properties": {
        "architectureDeltaId": {"$ref": "#/$defs/id", "description": "稳定识别一项目标架构变化的 Design Owner ID。"},
        "name": {"type": "string", "minLength": 1, "description": "面向评审展示的架构变化名称。"},
        "changeType": {"type": "string", "enum": ["NEW", "ADOPT", "ADJUST", "REPLACE", "RETIRE"], "description": "目标设计对现状起点采取的新建、采用、调整、替换或退役方式。"},
        "designItemId": {"$ref": "#/$defs/id", "description": "承载这项架构变化的目标 Design Item ID。"},
        "effectiveStartItemIds": {"$ref": "#/$defs/idArray", "description": "被采用或改变的 As-Is Effective Start ID；全新建设时为空。"},
        "summary": {"type": "string", "minLength": 1, "description": "说明相对现状改变了什么、保留了什么以及目标结果。"}
      },
      "allOf": [
        {
          "if": {"properties": {"changeType": {"not": {"const": "NEW"}}}, "required": ["changeType"]},
          "then": {"properties": {"effectiveStartItemIds": {"minItems": 1}}}
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designDecisionId", "name", "decision", "rationale", "designItemIds", "effectiveStartItemIds", "relatedFeatureIds", "decisionKind", "evidenceIds"],
      "properties": {
        "designDecisionId": {"$ref": "#/$defs/id", "description": "由 Design Owner 维护并供派生技术需求引用的稳定决策 ID。"},
        "name": {"type": "string", "minLength": 1, "description": "清楚概括待评审技术选择的决策名称。"},
        "decision": {"type": "string", "minLength": 1, "description": "已经选择的具体技术边界、责任、阈值或运行方式。"},
        "rationale": {"type": "string", "minLength": 1, "description": "基于需求、现状和证据说明为何采用该选择及其取舍。"},
        "designItemIds": {"$ref": "#/$defs/nonEmptyIdArray", "description": "落实该决策的目标 Design Item ID。"},
        "effectiveStartItemIds": {"$ref": "#/$defs/idArray", "description": "该决策采用、改变或约束的 As-Is Effective Start ID。"},
        "relatedFeatureIds": {"$ref": "#/$defs/nonEmptyIdArray", "description": "该决策服务或约束的 BUSINESS 与 TECHNICAL Feature ID。"},
        "decisionKind": {
          "type": "string",
          "enum": ["INTEGRATION_BOUNDARY", "PROVIDER_TARGET", "OPERATIONAL_THRESHOLD", "ENVIRONMENT_AUTHORITY", "CUTOVER_ROLLBACK", "OTHER"],
          "description": "用于证明 Scope Decision 已满足集成、目标方、运行阈值、环境权威或切换回滚义务的决策类别。"
        },
        "evidenceIds": {"$ref": "#/$defs/idArray", "description": "直接支撑该技术决策的 As-Is Evidence ID；类型化义务决策必须有证据。"},
        "adapterCompletesDelivery": {"type": "boolean", "description": "仅集成边界决策使用，说明交付是否在适配器端口完成而无需端到端实现。"}
      },
      "allOf": [
        {
          "if": {"required": ["adapterCompletesDelivery"]},
          "then": {"properties": {"decisionKind": {"const": "INTEGRATION_BOUNDARY"}}}
        }
      ]
    },
    "scopeDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureId", "decision", "rationale", "designItemIds", "effectiveStartItemIds"],
      "properties": {
        "featureId": {"type": "string", "pattern": "^feature-[a-z0-9]+(?:-[a-z0-9]+)*$", "description": "被目标设计明确处置的 BUSINESS 或 TECHNICAL Feature ID。"},
        "decision": {"type": "string", "enum": ["IN_SCOPE", "FULLY_COVERED", "OUT_OF_SCOPE"], "description": "该 Feature 需要交付、已由现状完整覆盖或明确排除的范围结论。"},
        "rationale": {"type": "string", "minLength": 1, "description": "结合需求、现状和责任边界解释范围结论，不使用空泛占位理由。"},
        "designItemIds": {"$ref": "#/$defs/idArray", "description": "交付该 Feature 的目标 Design Item ID；完整现状覆盖或排除时为空。"},
        "effectiveStartItemIds": {"$ref": "#/$defs/idArray", "description": "支撑完整现状覆盖或形成设计起点的 As-Is Effective Start ID。"},
        "requiredIntegrationBoundary": {
          "type": "string",
          "enum": ["NONE", "PORT_ONLY", "END_TO_END"],
          "description": "该 Feature 是否需要集成边界决策，以及责任止于适配器端口还是覆盖端到端交付。"
        },
        "requiredDecisionKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["INTEGRATION_BOUNDARY", "PROVIDER_TARGET", "OPERATIONAL_THRESHOLD", "ENVIRONMENT_AUTHORITY", "CUTOVER_ROLLBACK"]
          },
          "description": "该范围必须由关联 Design Decision 明确履行的类型化设计义务。"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "IN_SCOPE"}}, "required": ["decision"]},
          "then": {
            "required": ["requiredIntegrationBoundary", "requiredDecisionKinds"],
            "properties": {"designItemIds": {"minItems": 1}}
          }
        },
        {
          "if": {"properties": {"decision": {"const": "FULLY_COVERED"}}, "required": ["decision"]},
          "then": {"properties": {"effectiveStartItemIds": {"minItems": 1}}}
        }
      ]
    }
  }
}
