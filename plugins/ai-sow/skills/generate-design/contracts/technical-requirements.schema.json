{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:generate-design:technical-requirements:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["epics", "features"],
  "properties": {
    "epics": {"type": "array", "items": {"$ref": "#/$defs/epic"}},
    "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}}
  },
  "$defs": {
    "sourceDocumentId": {"type": "string", "pattern": "^source-document-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "epicId": {"type": "string", "pattern": "^epic-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "featureId": {"type": "string", "pattern": "^feature-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "designDecisionId": {"type": "string", "pattern": "^decision-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "effectiveStartItemId": {"type": "string", "pattern": "^effective-start-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "nonEmptyString": {"type": "string", "minLength": 1},
    "derivedRationale": {
      "type": "string",
      "pattern": "^设计决策/Decision\\s*[:：]\\s*[^；;\\r\\n]+[；;]\\s*产生原因/Cause\\s*[:：]\\s*[^；;\\r\\n]+[；;]\\s*不交付影响/Non-delivery impact\\s*[:：]\\s*(?:流程/Process|接口/API|质量属性/Quality attribute|责任边界/Responsibility boundary)\\s*\\|\\s*[^|\\r\\n]+\\s*->\\s*[^\\r\\n]+$"
    },
    "stableReference": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*[\\r\\n])(?![Ff][Ii][Ll][Ee]:)(?:[a-z][a-z0-9-]*:)?(?!\\.{1,2}(?:/|#|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|#|$))[A-Za-z0-9._-]+)*(?:#[A-Za-z0-9._~:/?@!$&'()*+,%=-]+)?$"
    },
    "sourceDocumentIdList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceDocumentId"}
    },
    "stableReferenceList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableReference"}
    },
    "designDecisionIdList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/designDecisionId"}
    },
    "effectiveStartItemIdList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/effectiveStartItemId"}
    },
    "featureIdList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/featureId"}
    },
    "sourceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sourceDocumentIds", "sourceReferences"],
      "properties": {
        "type": {"const": "SOURCE_INPUT"},
        "sourceDocumentIds": {"$ref": "#/$defs/sourceDocumentIdList"},
        "sourceReferences": {"$ref": "#/$defs/stableReferenceList"}
      }
    },
    "designDerived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "designDecisionIds", "effectiveStartItemIds", "rationale"],
      "properties": {
        "type": {"const": "DESIGN_DERIVED"},
        "designDecisionIds": {"$ref": "#/$defs/designDecisionIdList"},
        "effectiveStartItemIds": {"$ref": "#/$defs/effectiveStartItemIdList"},
        "relatedFeatureIds": {"$ref": "#/$defs/featureIdList"},
        "rationale": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "source": {"oneOf": [{"$ref": "#/$defs/sourceInput"}, {"$ref": "#/$defs/designDerived"}]},
    "designDerivedFeature": {
      "allOf": [
        {"$ref": "#/$defs/designDerived"},
        {
          "properties": {
            "rationale": {"$ref": "#/$defs/derivedRationale"}
          }
        }
      ]
    },
    "featureSource": {
      "oneOf": [
        {"$ref": "#/$defs/sourceInput"},
        {"$ref": "#/$defs/designDerivedFeature"}
      ]
    },
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epicId", "type", "name", "description", "source"],
      "properties": {
        "epicId": {"$ref": "#/$defs/epicId"},
        "type": {"const": "TECHNICAL"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "involvedSystemsData": {"$ref": "#/$defs/nonEmptyString"},
        "targetOutcome": {"$ref": "#/$defs/nonEmptyString"},
        "commonConstraintsOutOfScope": {"$ref": "#/$defs/nonEmptyString"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureId", "epicId", "name", "description", "source"],
      "properties": {
        "featureId": {"$ref": "#/$defs/featureId"},
        "epicId": {"$ref": "#/$defs/epicId"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "involvedSystemsData": {"$ref": "#/$defs/nonEmptyString"},
        "constraintsNfr": {"$ref": "#/$defs/nonEmptyString"},
        "source": {"$ref": "#/$defs/featureSource"}
      }
    }
  }
}
