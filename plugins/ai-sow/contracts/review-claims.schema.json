{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:review:claims:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["algorithm", "owner", "claims"],
  "properties": {
    "algorithm": {"const": "ai-sow-review-claims-v1", "description": "固定的断言投影算法。"},
    "owner": {"enum": ["analyze-requirement", "analyze-as-is", "generate-design", "generate-story", "generate-task"], "description": "拥有断言来源字段的专业 Owner。"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "ownerField", "text", "anchors", "kind", "confidence"],
        "properties": {
          "claimId": {"type": "string", "pattern": "^claim-[0-9a-f]{16}$", "description": "由 Owner、字段路径和文本确定性生成的断言 ID。"},
          "ownerField": {"type": "string", "pattern": "^/.+", "description": "断言原文所在的 JSON Pointer。"},
          "text": {"type": "string", "minLength": 1, "description": "待核验的单条专业断言。"},
          "anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": {"type": "string", "minLength": 1, "description": "核验断言所需的最小项目相对或逻辑 anchor。"},
                "glob": {"type": "string", "minLength": 1, "description": "count anchor 使用的项目相对文件 glob。"},
                "expr": {"type": "string", "minLength": 1, "description": "机械求值表达式。"},
                "expected": {"type": "integer", "minimum": 0, "description": "机械求值的期望计数。"},
                "anchorSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "anchor 文件当前字节的 SHA-256。"}
              }
            }
          },
          "kind": {"enum": ["FACTUAL", "JUDGMENT", "COMPLETENESS"], "description": "决定使用脚本、廉价事实核验或深度判断模型。"},
          "confidence": {"enum": ["HIGH", "LOW"], "description": "高且有 anchor 的断言可进入廉价模型通道。"},
          "derivedFrom": {"type": "string", "pattern": "^premise-[a-z0-9]+(?:-[a-z0-9]+)*$", "description": "触发该断言调查的前提 ID。"},
          "verification": {
            "type": "object",
            "additionalProperties": true,
            "required": ["verdict"],
            "properties": {
              "verdict": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
              "lineReference": {"type": "string", "minLength": 1},
              "anchorSha256": {"type": "string"},
              "verifiedBy": {"type": "string"},
              "verifierModel": {"type": "string"}
            }
          }
        }
      },
      "description": "可独立并发核验的最小断言切片。"
    }
  }
}
