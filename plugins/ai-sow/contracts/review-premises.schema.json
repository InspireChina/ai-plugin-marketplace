{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:review:premises:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["algorithm", "owner", "hypothesis", "factFamilies", "premises"],
  "properties": {
    "algorithm": {"const": "ai-sow-review-premises-v1", "description": "固定的前提清单投影算法。"},
    "owner": {"const": "analyze-as-is", "description": "唯一维护此前提清单的 Owner。"},
    "hypothesis": {"type": "string", "minLength": 1, "description": "基于已批准 Requirements 的一句话目标方案假设。"},
    "factFamilies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["modules", "deploymentResources", "criticalConfiguration", "springProfiles", "migrationTables", "ciWorkflows", "kafkaBoundaries", "testInfrastructure", "codegraphCoverage"]
      },
      "description": "由当前前提激活的确定性仓库事实族。"
    },
    "premises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["premiseId", "text", "falsificationMethod", "verdict", "impact"],
        "properties": {
          "premiseId": {"type": "string", "pattern": "^premise-[a-z0-9]+(?:-[a-z0-9]+)*$", "description": "在当前调查中稳定的前提 ID。"},
          "text": {"type": "string", "minLength": 1, "description": "方案假设依赖的可证伪前提。"},
          "falsificationMethod": {"type": "string", "minLength": 1, "description": "只读取定向 anchor 的最小证伪方法。"},
          "verdict": {"enum": ["SUPPORTED", "FALSIFIED", "UNVERIFIED"], "description": "定向证伪结果。"},
          "impact": {"type": "string", "minLength": 1, "description": "该结果对现状起点、范围或估算的影响。"},
          "anchorPaths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.{1,2})(?:/|$)).+$"},
            "description": "支持 verdict 的项目相对文件 anchor。"
          }
        }
      },
      "description": "从目标方案反推且逐条证伪的前提清单。"
    }
  }
}
