{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:tests:model-efficiency-incident:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "incidentId",
    "firstFailedReceiptSha256",
    "classification",
    "firstCostDivergence",
    "criticalPath",
    "tokenFlow",
    "reworkGraph",
    "sharedRootCause",
    "affectedStages",
    "stoppedBeforeNextWork"
  ],
  "properties": {
    "contract": {"const": "ai-sow-model-efficiency-incident-v1"},
    "incidentId": {"type": "string", "minLength": 1},
    "firstFailedReceiptSha256": {"$ref": "#/$defs/sha256"},
    "classification": {
      "enum": ["PLUGIN_DEFECT", "ENVIRONMENT_FAILURE", "TEST_HARNESS_DEFECT", "UNCLASSIFIED"]
    },
    "firstCostDivergence": {"type": "string", "minLength": 1},
    "criticalPath": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
    "tokenFlow": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/flow"}},
    "reworkGraph": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "sharedRootCause": {"type": "string", "minLength": 1},
    "affectedStages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stoppedBeforeNextWork": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "wallMilliseconds", "critical"],
      "properties": {
        "stage": {"type": "string", "minLength": 1},
        "wallMilliseconds": {"type": "number", "minimum": 0},
        "critical": {"type": "boolean"}
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "inputTokens", "outputTokens", "controlPlaneTokens", "toolContextTokens"],
      "properties": {
        "stage": {"type": "string", "minLength": 1},
        "inputTokens": {"type": "integer", "minimum": 0},
        "outputTokens": {"type": "integer", "minimum": 0},
        "controlPlaneTokens": {"type": "integer", "minimum": 0},
        "toolContextTokens": {"type": "integer", "minimum": 0}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "reason"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
