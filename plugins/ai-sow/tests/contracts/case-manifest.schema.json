{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:tests:case-manifest:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "cases"
  ],
  "properties": {
    "contract": {
      "const": "ai-sow-e2e-case-manifest-v1"
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "mode",
          "fixtureRootPath",
          "requiredActionContracts"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "mode": {
            "enum": [
              "GREENFIELD",
              "BROWNFIELD"
            ]
          },
          "fixtureRootPath": {
            "$ref": "#/$defs/path"
          },
          "requiredActionContracts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:[A-Z_]+-v1|TASK-v2)$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\.).+$"
    }
  }
}
