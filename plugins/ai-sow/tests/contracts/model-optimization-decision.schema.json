{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:tests:model-optimization-decision:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "decisionId",
    "incidentSha256",
    "options",
    "selectedOptionId",
    "expectedNetBenefit",
    "costShiftChecks",
    "ownerClosure",
    "semanticGuards",
    "privacyGuards",
    "recoveryGuards",
    "validationPlan",
    "rollbackConditions"
  ],
  "properties": {
    "contract": {"const": "ai-sow-model-optimization-decision-v1"},
    "decisionId": {"type": "string", "minLength": 1},
    "incidentSha256": {"$ref": "#/$defs/sha256"},
    "options": {
      "type": "array",
      "minItems": 3,
      "contains": {"properties": {"kind": {"const": "NO_CHANGE"}}, "required": ["kind"]},
      "minContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["optionId", "kind", "systemChange", "expectedWallDeltaRatio", "expectedTokenDeltaRatio", "risks"],
        "properties": {
          "optionId": {"type": "string", "minLength": 1},
          "kind": {"enum": ["NO_CHANGE", "SYSTEM_OPTIMIZATION"]},
          "systemChange": {"type": "string", "minLength": 1},
          "expectedWallDeltaRatio": {"type": "number"},
          "expectedTokenDeltaRatio": {"type": "number"},
          "risks": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "selectedOptionId": {"type": "string", "minLength": 1},
    "expectedNetBenefit": {"type": "string", "minLength": 1},
    "costShiftChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage1", "downstreamReview", "office", "promote", "controlPlane", "retryRework"],
      "properties": {
        "stage1": {"type": "boolean"},
        "downstreamReview": {"type": "boolean"},
        "office": {"type": "boolean"},
        "promote": {"type": "boolean"},
        "controlPlane": {"type": "boolean"},
        "retryRework": {"type": "boolean"}
      }
    },
    "ownerClosure": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "semanticGuards": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "privacyGuards": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "recoveryGuards": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validationPlan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollbackConditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
