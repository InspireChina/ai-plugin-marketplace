{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sow:tests:owner-test-descriptor:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["algorithm", "ownerSkill", "contractVersion", "positive", "negativeCases"],
  "properties": {
    "algorithm": {"const": "ai-sow-owner-test-descriptor-v1"},
    "ownerSkill": {"enum": ["analyze-as-is", "analyze-requirement", "generate-design", "generate-story", "generate-task"]},
    "contractVersion": {"const": "0.2"},
    "positive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "riskResolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["riskId", "status", "evidence"],
            "properties": {
              "riskId": {"type": "string", "minLength": 1},
              "status": {"const": "已明确"},
              "evidence": {"type": "string", "pattern": "SIMULATED"}
            }
          }
        }
      }
    },
    "negativeCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "mutation", "expected"],
        "properties": {
          "caseId": {"type": "string", "pattern": "^(?:N(?:0[1-9]|10)|P0[1-9])$"},
          "mutation": {"$ref": "#/$defs/operation"},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner", "outcome", "diagnosticCodes", "sideEffects"],
            "properties": {
              "owner": {"enum": ["analyze-as-is", "analyze-requirement", "generate-design", "generate-story", "generate-task"]},
              "outcome": {"const": "BLOCKED"},
              "diagnosticCodes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
              },
              "sideEffects": {"type": "object"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "selector", "value"],
      "properties": {
        "op": {"enum": ["replace-field", "remove-by-id", "append-object", "replace-review-declaration", "replace-anchor"]},
        "selector": {"type": "object", "minProperties": 1},
        "value": {}
      }
    }
  }
}
